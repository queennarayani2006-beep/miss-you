```html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Secret For You ❤️</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    overflow:hidden;
    font-family:Arial,sans-serif;
    background:
        radial-gradient(circle at top,#ffb6d5,transparent 35%),
        linear-gradient(135deg,#170b25,#45133f,#751548);
    color:white;
}

.page{
    display:none;
    width:100%;
    max-width:520px;
    padding:25px;
    text-align:center;
    animation:fadeIn 1s ease;
}

.page.active{
    display:block;
}

.card{
    padding:40px 25px;
    border-radius:30px;
    background:rgba(255,255,255,.11);
    border:1px solid rgba(255,255,255,.25);
    backdrop-filter:blur(15px);
    box-shadow:0 20px 60px rgba(0,0,0,.4);
}

.lock{
    font-size:90px;
    margin-bottom:15px;
    transition:.6s;
}

h1{
    font-size:32px;
    margin-bottom:15px;
    background:linear-gradient(90deg,#fff,#ff9ec5,#fff);
    -webkit-background-clip:text;
    color:transparent;
}

h2{
    color:#ffb1ce;
    margin-bottom:20px;
}

p{
    line-height:1.8;
    color:#f8dce8;
    margin-bottom:15px;
}

input{
    width:100%;
    padding:16px;
    margin:20px 0 12px;
    border-radius:15px;
    border:2px solid #ff8db8;
    outline:none;
    text-align:center;
    font-size:18px;
    color:white;
    background:rgba(255,255,255,.1);
}

input::placeholder{
    color:#e7bfd1;
}

button{
    width:100%;
    padding:16px;
    border:0;
    border-radius:16px;
    background:linear-gradient(135deg,#ff4389,#ff75a9);
    color:white;
    font-size:17px;
    font-weight:bold;
    cursor:pointer;
    transition:.3s;
    box-shadow:0 8px 25px rgba(255,60,130,.35);
}

button:hover{
    transform:scale(1.03);
}

#error{
    color:#ff9eba;
    margin-top:15px;
    min-height:25px;
}

.heart{
    font-size:80px;
    animation:beat 1.2s infinite;
    margin-bottom:10px;
}

.love-box{
    padding:25px;
    border-radius:22px;
    background:rgba(255,255,255,.08);
    margin:20px 0;
}

.divider{
    color:#ff91b9;
    letter-spacing:8px;
    margin:20px 0;
}

.special{
    font-size:25px;
    font-weight:bold;
    color:#ff9fc4;
}

.small{
    font-size:13px;
    color:#dcb8ca;
}

.floating-heart{
    position:fixed;
    bottom:-50px;
    z-index:1;
    pointer-events:none;
    animation:floatUp 5s linear forwards;
}

@keyframes fadeIn{
    from{
        opacity:0;
        transform:scale(.85) translateY(30px);
    }
    to{
        opacity:1;
        transform:scale(1) translateY(0);
    }
}

@keyframes beat{
    0%,100%{transform:scale(1)}
    50%{transform:scale(1.2)}
}

@keyframes floatUp{
    to{
        transform:translateY(-110vh) rotate(360deg);
        opacity:0;
    }
}

@media(max-width:500px){
    h1{font-size:26px}
    .lock{font-size:70px}
    .card{padding:30px 20px}
}
</style>
</head>

<body>

<!-- ================= PAGE 1 ================= -->

<div class="page active" id="page1">

<div class="card">

<div class="lock" id="lock">🔒</div>

<h1>A Secret For You 💕</h1>

<p>
Something very special is waiting for you...
</p>

<p>
But first, you need to unlock it. 🔐
</p>

<input
type="password"
id="code"
placeholder="Enter our secret code"
>

<button onclick="unlock()">
🔑 Unlock My Heart
</button>

<div id="error"></div>

<p class="small">
Only my special girl knows the answer... 😜❤️
</p>

</div>
</div>


<!-- ================= PAGE 2 ================= -->

<div class="page" id="page2">

<div class="card">

<div class="heart">❤️</div>

<h1>You Unlocked My Heart!</h1>

<p>
🔓 The lock is open...
</p>

<div class="love-box">

<h2>My Dear Love 💕</h2>

<p>
Unna paatha odane en heart-ku
oru different feeling varudhu. 🥹❤️
</p>

<p>
You're not just someone I love...
<br>
You're someone I never want to lose. 💗
</p>

<p>
En life-la nee vandhadhukku apram,
ordinary moments kooda special ah maariduchu. ✨
</p>

<div class="divider">
♥ ♥ ♥
</div>

<p>
You are my favourite person,
my happiest thought,
and my sweetest feeling. ❤️
</p>

</div>

<button onclick="nextPage()">
💌 I Have One More Thing...
</button>

</div>
</div>


<!-- ================= PAGE 3 ================= -->

<div class="page" id="page3">

<div class="card">

<div class="heart">💖</div>

<h1>One Last Thing...</h1>

<div class="love-box">

<h2>I Love You ❤️</h2>

<p>
I don't know what the future holds...
</p>

<p>
But if I get to choose,
<br>
I want you to be a part of it. 🥹
</p>

<p>
Through every smile,
every silly fight,
every crazy moment,
and every beautiful memory...
</p>

<p class="special">
I will choose you. ❤️
</p>

<div class="divider">
💗 ✨ 💗
</div>

<p>
"Enakku enna venum nu ketta...
<br>
perusa edhuvum venam...
<br>
nee mattum pothum." ❤️
</p>

<h2>
Forever & Always ♾️
</h2>

</div>

<button onclick="finalSurprise()">
❤️ I Love You Too ❤️
</button>

</div>
</div>


<script>

/* =========================================
   CHANGE YOUR SECRET CODE HERE
   ========================================= */

const SECRET_CODE = "Ammu";


/* =========================================
   UNLOCK PAGE
   ========================================= */

function unlock(){

    const code =
        document.getElementById("code").value.trim();

    const error =
        document.getElementById("error");

    const lock =
        document.getElementById("lock");

    if(code === SECRET_CODE){

        error.innerHTML =
            "Correct! ❤️ Opening your surprise...";

        lock.innerHTML = "🔓";

        lock.style.transform =
            "rotate(-15deg) scale(1.3)";

        createHearts(30);

        setTimeout(function(){

            document.getElementById("page1")
                .classList.remove("active");

            document.getElementById("page2")
                .classList.add("active");

        },1800);

    }else{

        error.innerHTML =
            "Wrong code 😜 Try again, my love ❤️";

        document.getElementById("code").value = "";

        lock.style.transform =
            "rotate(10deg)";

        setTimeout(function(){

            lock.style.transform = "";

        },300);
    }
}


/* =========================================
   ENTER KEY
   ========================================= */

document.getElementById("code")
.addEventListener("keydown",function(e){

    if(e.key === "Enter"){
        unlock();
    }

});


/* =========================================
   PAGE 2 → PAGE 3
   ========================================= */

function nextPage(){

    createHearts(35);

    document.getElementById("page2")
        .classList.remove("active");

    document.getElementById("page3")
        .classList.add("active");
}


/* =========================================
   FLOATING HEARTS
   ========================================= */

function createHearts(amount){

    const heartTypes=[
        "❤️","💖","💕","💗",
        "💓","💞","💘"
    ];

    for(let i=0;i<amount;i++){

        setTimeout(function(){

            const heart =
                document.createElement("div");

            heart.className="floating-heart";

            heart.innerHTML =
                heartTypes[
                    Math.floor(
                        Math.random()*heartTypes.length
                    )
                ];

            heart.style.left =
                Math.random()*100+"vw";

            heart.style.fontSize =
                (15+Math.random()*35)+"px";

            heart.style.animationDuration =
                (4+Math.random()*4)+"s";

            document.body.appendChild(heart);

            setTimeout(function(){
                heart.remove();
            },8000);

        },i*80);
    }
}


/* =========================================
   FINAL BUTTON
   ========================================= */

function finalSurprise(){

    createHearts(100);

    setTimeout(function(){

        alert(
            "I Love You Too! ❤️🥹💖\n\n" +
            "You are my favourite person forever! ♾️"
        );

    },600);
}


/* =========================================
   STARTING HEARTS
   ========================================= */

window.addEventListener("load",function(){

    createHearts(10);

});

</script>

</body>
</html>
```
